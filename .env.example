# ==============================================================================
# DUAL-PIPELINE CLINICAL INTELLIGENCE ENGINE: ENVIRONMENT CONFIGURATION TEMPLATE
# Reference template for environment variables.
# 
# NOTE ON CONFIGURATION LOADING:
# The application reads environment variables directly from the host system environment
# via Python's 'os.getenv' with safe local defaults. Automatic loading from a local
# '.env' file is not enabled at runtime in this Phase 1 prototype. If overriding defaults,
# variables must be supplied externally via your shell environment, process runner, or container.
#
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# --- Application Server Configuration ---
APP_NAME="Clinical Intelligence Benchmark Console"
APP_ENV=development                # Supported: development | staging | production
DEBUG=false                        # Set to true for auto-reload in local development
HOST=127.0.0.1                     # Localhost binding (use 0.0.0.0 for containerized deployment)
PORT=8000                          # Port for FastAPI / Uvicorn server

# --- Security & CORS Configuration ---
# Comma-separated list of permitted origins for the web interface
CORS_ALLOWED_ORIGINS="http://127.0.0.1:8000,http://localhost:8000"

# --- Storage & Dataset Paths (Relative to project root) ---
DATA_CORPUS_DIR="data/corpus"
GOLD_BENCHMARK_PATH="data/benchmark/gold_benchmark.json"
COMPARATIVE_METRICS_PATH="eval/comparative_metrics.json"

# ==============================================================================
# FUTURE SEMESTER 8 INTEGRATION PLACEHOLDERS (NOT USED IN PHASE-I)
# The variables below are reserved for upcoming Neo4j and local LLM integrations.
# ==============================================================================
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=biomistral:7b-q4_k_m
